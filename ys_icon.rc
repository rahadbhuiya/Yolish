    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Exploidus"
      VALUE "FileDescription",  "Yolish Language Compiler\0"
      VALUE "FileVersion",      "2.8.0.0\0"
      VALUE "InternalName",     "ys\0"
      VALUE "LegalCopyright",   "Copyright (C) 2025 .Bhuiya\0"
      VALUE "OriginalFilename", "ys.exe\0"
      VALUE "ProductName",      "Yolish\0"
      VALUE "ProductVersion",   "2.8\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
