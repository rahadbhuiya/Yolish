#include <winver.h>

// Icon
IDI_ICON1 ICON "icons/ys.ico"

// Version info
VS_VERSION_INFO VERSIONINFO
  FILEVERSION     2,8,0,0
  PRODUCTVERSION  2,8,0,0
  FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
  FILEFLAGS       0
  FILEOS          VOS__WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
